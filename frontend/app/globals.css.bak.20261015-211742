@import "tailwindcss";

:root {
  --white: #ffffff;
  --purple: #51307c;
  --magenta: #b3277b;
  --navy: #032f62;
  --ink: #171525;
  --muted: #696776;
  --line: #e9e7ee;
  --soft-purple: #FFFFFF;
  --soft-pink: #fff5fa;
  --content-width: 1200px;
}

@theme inline {
  --color-background: var(--white);
  --color-foreground: var(--ink);
  --font-sans: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 95px;
  background: #ffffff;
}

body {
  margin: 0;
  background: #ffffff;
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

body,
main,
section,
footer {
  background-color: #ffffff;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

button:focus-visible,
a:focus-visible {
  outline: 3px solid var(--magenta);
  outline-offset: 4px;
}

::selection {
  color: #ffffff;
  background: var(--purple);
}

.section-shell,
.nav-shell {
  width: min(var(--content-width), calc(100% - 64px));
  margin-inline: auto;
}

/* Header */

.site-header {
  position: sticky;
  z-index: 50;
  top: 0;
  width: 100%;
  border-bottom: 1px solid rgba(81, 48, 124, 0.09);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(16px);
}

.nav-shell {
  display: flex;
  min-height: 82px;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10px;
}

.brand-mark {
  position: relative;
  display: inline-flex;
  width: 35px;
  height: 35px;
  align-items: center;
  justify-content: center;
  gap: 3px;
  overflow: hidden;
  border-radius: 11px;
  background: linear-gradient(145deg, var(--purple), var(--magenta));
  transform: rotate(-4deg);
}

.brand-mark span {
  display: block;
  width: 4px;
  border-radius: 4px;
  background: #ffffff;
  transform: skew(-15deg);
}

.brand-mark span:nth-child(1) {
  height: 11px;
}

.brand-mark span:nth-child(2) {
  height: 19px;
}

.brand-mark span:nth-child(3) {
  height: 14px;
}

.brand-wordmark {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.brand-wordmark strong {
  color: var(--navy);
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.9px;
}

.brand-wordmark small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: clamp(20px, 3vw, 38px);
}

.main-nav > a:not(.nav-contact) {
  color: #4f4c5c;
  font-size: 13px;
  font-weight: 600;
  transition: color 180ms ease;
}

.main-nav > a:not(.nav-contact):hover {
  color: var(--magenta);
}

.nav-contact {
  display: inline-flex;
  min-height: 43px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 17px;
  border-radius: 7px;
  background: var(--navy);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  transition:
    background 180ms ease,
    transform 180ms ease;
}

.nav-contact:hover {
  background: var(--purple);
  transform: translateY(-1px);
}

.menu-toggle {
  display: none;
  width: 43px;
  height: 43px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #ffffff;
  cursor: pointer;
}

.menu-toggle span {
  width: 19px;
  height: 2px;
  border-radius: 2px;
  background: var(--navy);
}

/* Shared typography */

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--purple);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.8px;
  line-height: 1.5;
}

.eyebrow-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--magenta);
  box-shadow: 0 0 0 4px rgba(179, 39, 123, 0.09);
}

.gradient-text {
  color: var(--purple);
  background: linear-gradient(100deg, var(--purple) 8%, var(--magenta) 95%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.button {
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 0 21px;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 700;
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    background 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: #ffffff;
  background: linear-gradient(105deg, var(--purple), var(--magenta));
  box-shadow: 0 8px 22px rgba(81, 48, 124, 0.14);
}

.button-primary:hover {
  box-shadow: 0 12px 28px rgba(81, 48, 124, 0.23);
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--navy);
  font-size: 12px;
  font-weight: 700;
}

.text-link svg,
.service-link svg,
.result-link svg {
  transition: transform 180ms ease;
}

.text-link:hover svg,
.service-link:hover svg,
.result-link:hover svg {
  transform: translate(3px, -2px);
}

/* Hero */

.hero {
  position: relative;
  display: grid;
  min-height: 635px;
  grid-template-columns: 1fr 0.94fr;
  align-items: center;
  gap: 36px;
  padding-top: 66px;
  padding-bottom: 88px;
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding: 10px 0 20px;
}

.hero h1 {
  margin: 27px 0 22px;
  color: var(--navy);
  font-size: clamp(53px, 6.3vw, 82px);
  font-weight: 800;
  letter-spacing: -5px;
  line-height: 0.99;
}

.hero-description {
  max-width: 470px;
  margin: 0;
  color: var(--muted);
  font-size: 15px;
  line-height: 1.9;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 25px;
  margin-top: 31px;
}

.hero-proof {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 45px;
}

.proof-symbol {
  display: flex;
  width: 37px;
  height: 37px;
  align-items: center;
  justify-content: center;
  border: 1px solid #e7ddef;
  border-radius: 50%;
  color: var(--purple);
  background: #ffffff;
}

.hero-proof > span:last-child {
  display: flex;
  flex-direction: column;
}

.hero-proof strong {
  color: var(--navy);
  font-size: 11px;
}

.hero-proof small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 11px;
}

.hero-art {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 535px;
  aspect-ratio: 1 / 0.94;
  align-items: center;
  justify-content: center;
  justify-self: end;
  overflow: hidden;
  border: 1px solid #FFFFFF;
  border-radius: 44% 44% 13px 13px;
  background:
    radial-gradient(ellipse at 51% 47%, rgba(179, 39, 123, 0.09), transparent 54%),
    linear-gradient(145deg, #FFFFFF 0%, #ffffff 48%, #FFFFFF 100%);
}

.hero-art::before {
  position: absolute;
  inset: 15px;
  border: 1px solid rgba(81, 48, 124, 0.08);
  border-radius: 44% 44% 7px 7px;
  content: "";
}

.art-orbit {
  position: absolute;
  border: 1px solid rgba(81, 48, 124, 0.2);
  border-radius: 50%;
}

.orbit-one {
  width: 68%;
  height: 68%;
  transform: rotate(-32deg) scaleY(0.77);
}

.orbit-two {
  width: 85%;
  height: 46%;
  border-color: rgba(179, 39, 123, 0.2);
  transform: rotate(36deg);
}

.orbit-three {
  width: 45%;
  height: 87%;
  border-color: rgba(3, 47, 98, 0.14);
  transform: rotate(38deg);
}

.art-core {
  position: relative;
  z-index: 2;
  display: flex;
  width: 190px;
  height: 190px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  color: #ffffff;
  background: linear-gradient(145deg, #654494, #51307c 52%, #8c317f);
  box-shadow:
    0 0 0 13px rgba(81, 48, 124, 0.045),
    0 22px 65px rgba(81, 48, 124, 0.23);
}

.core-spark {
  margin-bottom: -4px;
  color: #f2b9df;
  font-size: 22px;
}

.core-name {
  font-size: 57px;
  font-weight: 800;
  letter-spacing: -4px;
  line-height: 1.15;
}

.core-caption {
  margin-top: 9px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2px;
}

.art-card {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 17px;
  border: 1px solid rgba(81, 48, 124, 0.1);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14px 38px rgba(29, 19, 54, 0.08);
}

.art-card-top {
  top: 20%;
  right: 1%;
}

.art-card-bottom {
  bottom: 19%;
  left: 1%;
}

.art-card > span:last-child {
  display: flex;
  flex-direction: column;
}

.art-card small {
  color: #81778c;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
}

.art-card strong {
  margin-top: 3px;
  color: var(--navy);
  font-size: 12px;
}

.art-card-icon {
  display: flex;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  color: var(--purple);
  background: #FFFFFF;
  font-size: 24px;
}

.art-icon-pink {
  color: var(--magenta);
  background: #fff0f8;
}

.art-cross {
  position: absolute;
  width: 15px;
  height: 15px;
}

.art-cross::before,
.art-cross::after {
  position: absolute;
  top: 50%;
  left: 50%;
  background: var(--magenta);
  content: "";
  transform: translate(-50%, -50%);
}

.art-cross::before {
  width: 15px;
  height: 1px;
}

.art-cross::after {
  width: 1px;
  height: 15px;
}

.cross-one {
  top: 20%;
  left: 23%;
}

.cross-two {
  right: 16%;
  bottom: 25%;
  transform: scale(0.7);
}

.floating-dot {
  position: absolute;
  z-index: 2;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--magenta);
  box-shadow: 0 0 0 6px rgba(179, 39, 123, 0.08);
}

.floating-dot-one {
  top: 31%;
  left: 15%;
}

.floating-dot-two {
  right: 16%;
  bottom: 36%;
  width: 6px;
  height: 6px;
  background: var(--navy);
}

.floating-dot-three {
  top: 15%;
  right: 23%;
  width: 5px;
  height: 5px;
  background: var(--purple);
}

.art-side-label {
  position: absolute;
  right: -45px;
  bottom: 43%;
  color: #81778c;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.4px;
  transform: rotate(90deg);
}

.hero-bottom {
  position: absolute;
  right: 0;
  bottom: 24px;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20px;
  border-top: 1px solid var(--line);
  color: #898493;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.hero-bottom a {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hero-bottom a span {
  color: var(--magenta);
  font-size: 15px;
}

/* Intro strip */

.intro-strip {
  border-block: 1px solid #FFFFFF;
  background: #ffffff;
}

.intro-inner {
  display: flex;
  min-height: 150px;
  align-items: center;
  justify-content: space-between;
  gap: 45px;
  padding-block: 30px;
}

.intro-inner > p:first-child {
  margin: 0;
  color: var(--navy);
  font-size: clamp(24px, 3vw, 37px);
  font-weight: 800;
  letter-spacing: -1.5px;
  line-height: 1.25;
}

.intro-inner > p:first-child span {
  color: var(--magenta);
}

.intro-note {
  max-width: 390px;
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
}

.intro-mobile-break {
  display: none;
}

/* Services */

.section {
  padding-block: 108px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 45px;
  margin-bottom: 46px;
}

.section-heading h2,
.about-copy h2,
.team-heading h2 {
  margin: 17px 0 0;
  color: var(--navy);
  font-size: clamp(37px, 4.6vw, 57px);
  font-weight: 800;
  letter-spacing: -2.9px;
  line-height: 1.1;
}

.section-description {
  max-width: 370px;
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 17px;
}

.service-card {
  position: relative;
  display: flex;
  min-height: 300px;
  flex-direction: column;
  padding: 24px 21px 22px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #ffffff;
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.service-card:hover {
  border-color: #d7c5e6;
  box-shadow: 0 15px 40px rgba(37, 22, 65, 0.055);
  transform: translateY(-4px);
}

.service-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 23px;
}

.service-icon {
  display: flex;
  width: 49px;
  height: 49px;
  align-items: center;
  justify-content: center;
  border: 1px solid #e9def3;
  border-radius: 12px;
  color: var(--purple);
  background: #FFFFFF;
}

.service-number {
  color: #aaa3b4;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}

.service-card h3 {
  margin: 0 0 10px;
  color: var(--navy);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

.service-card > p {
  margin: 0 0 21px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.85;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-right: 22px;
}

.service-tags span {
  padding: 4px 7px;
  border: 1px solid #FFFFFF;
  border-radius: 4px;
  color: #6d6678;
  font-size: 9px;
  font-weight: 600;
}

.service-link {
  position: absolute;
  right: 20px;
  bottom: 20px;
  display: flex;
  width: 29px;
  height: 29px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--purple);
  background: #FFFFFF;
}

/* Results */

.results-section {
  padding-block: 105px;
  border-block: 1px solid #FFFFFF;
  background: #ffffff;
}

.results-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.result-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #ffffff;
  transition:
    box-shadow 180ms ease,
    transform 180ms ease;
}

.result-card:hover {
  box-shadow: 0 18px 45px rgba(37, 22, 65, 0.07);
  transform: translateY(-4px);
}

.result-visual {
  position: relative;
  display: flex;
  height: 245px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.result-purple {
  background:
    radial-gradient(ellipse at 48% 48%, rgba(179, 39, 123, 0.14), transparent 60%),
    #FFFFFF;
}

.result-blue {
  background:
    radial-gradient(ellipse at 52% 55%, rgba(3, 47, 98, 0.13), transparent 61%),
    #FFFFFF;
}

.result-pink {
  background:
    radial-gradient(ellipse at 50% 52%, rgba(179, 39, 123, 0.12), transparent 62%),
    #fff4f9;
}

.result-category {
  position: absolute;
  z-index: 3;
  top: 17px;
  left: 18px;
  color: #70647f;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.result-visual-art {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.brand-orb {
  display: flex;
  width: 106px;
  height: 106px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 28px;
  color: #ffffff;
  font-size: 50px;
  font-weight: 800;
  box-shadow: 0 15px 35px rgba(54, 28, 82, 0.13);
}

.orb-a {
  z-index: 1;
  background: linear-gradient(145deg, #51307c, #8c347e);
  transform: translate(17px, -4px) rotate(-11deg);
}

.orb-b {
  z-index: 2;
  background: linear-gradient(145deg, #b3277b, #e17ab6);
  transform: translate(-17px, 19px) rotate(11deg);
}

.visual-plus {
  position: absolute;
  top: 29%;
  right: 20%;
  color: var(--purple);
  font-size: 27px;
}

.visual-chart {
  display: flex;
  width: 66%;
  height: 58%;
  align-items: end;
  justify-content: center;
  gap: 9px;
  padding: 14px;
  border: 1px solid rgba(3, 47, 98, 0.12);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.75);
}

.visual-chart span {
  flex: 1;
  max-width: 28px;
  border-radius: 5px 5px 0 0;
  background: linear-gradient(180deg, #7b5ba7, #032f62);
}

.visual-chart span:nth-child(1) { height: 23%; }
.visual-chart span:nth-child(2) { height: 38%; }
.visual-chart span:nth-child(3) { height: 34%; }
.visual-chart span:nth-child(4) { height: 55%; }
.visual-chart span:nth-child(5) { height: 49%; }
.visual-chart span:nth-child(6) { height: 76%; }
.visual-chart span:nth-child(7) { height: 95%; }

.visual-social {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 25px 30px;
  border: 1px solid rgba(179, 39, 123, 0.12);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 16px 40px rgba(90, 29, 76, 0.07);
  transform: rotate(-5deg);
}

.visual-social span {
  color: var(--navy);
  font-size: 29px;
  font-weight: 800;
  letter-spacing: -1.7px;
  line-height: 1.15;
}

.visual-social span:nth-child(2) {
  color: var(--purple);
}

.visual-social span:nth-child(3) {
  color: var(--magenta);
}

.result-visual-footer {
  position: absolute;
  right: 17px;
  bottom: 15px;
  left: 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7a7187;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.result-visual-footer strong {
  color: var(--purple);
  font-size: 10px;
}

.result-copy {
  padding: 24px 22px 23px;
}

.result-copy h3 {
  margin: 0 0 11px;
  color: var(--navy);
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.7px;
  line-height: 1.4;
}

.result-copy > p {
  min-height: 62px;
  margin: 0 0 21px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.85;
}

.result-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--purple);
  font-size: 11px;
  font-weight: 800;
}

.results-note {
  margin: 24px 0 0;
  color: #817b8b;
  font-size: 10px;
  line-height: 1.7;
}

/* About */

.about-section {
  display: grid;
  grid-template-columns: 0.95fr 1fr;
  align-items: center;
  gap: clamp(50px, 8vw, 105px);
  padding-block: 112px;
}

.about-visual {
  position: relative;
  display: flex;
  min-height: 470px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid #FFFFFF;
  border-radius: 13px;
  background: linear-gradient(145deg, #FFFFFF, #ffffff 58%, #FFFFFF);
}

.about-visual-grid {
