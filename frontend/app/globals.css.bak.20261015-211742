/* ReachForever client image holder */
.hero-art.hero-image-frame {
  position: relative;
  display: block;
  width: 100%;
  max-width: 535px;
  min-width: 0;
  aspect-ratio: 1 / 0.94;
  justify-self: end;
  overflow: hidden;
  border: 1px solid rgba(81, 48, 124, 0.2);
  border-radius: 28px;
  background: #ffffff;
  box-shadow: 0 20px 60px rgba(3, 47, 98, 0.05);
}

.hero-art.hero-image-frame::before,
.hero-art.hero-image-frame::after {
  content: none;
}

.hero-image-placeholder {
  position: absolute;
  inset: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px dashed rgba(81, 48, 124, 0.2);
  border-radius: 20px;
  background: #ffffff;
}

.hero-image-placeholder::before {
  position: absolute;
  top: -1px;
  left: 0;
  width: 34%;
  height: 3px;
  border-radius: 3px;
  background: linear-gradient(90deg, #51307c, #b3277b);
  content: "";
}

.hero-image-placeholder::after {
  position: absolute;
  right: -1px;
  bottom: 0;
  width: 3px;
  height: 30%;
  border-radius: 3px;
  background: linear-gradient(180deg, #b3277b, #032f62);
  content: "";
}

.hero-image-letter {
  color: #51307c;
  font-size: clamp(150px, 22vw, 280px);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.08em;
  opacity: 0.045;
  user-select: none;
}

@media (max-width: 760px) {
  .hero-art.hero-image-frame {
    width: 100%;
    max-width: 530px;
    aspect-ratio: 1 / 0.83;
    justify-self: center;
    border-radius: 24px;
  }

  .hero-image-placeholder {
    inset: 10px;
    border-radius: 17px;
  }

  .hero-image-letter {
    font-size: clamp(140px, 40vw, 220px);
  }
}

@media (max-width: 420px) {
  .hero-art.hero-image-frame {
    aspect-ratio: 1 / 0.9;
  }
}

/* Database-driven ReachForever results */
.results-section {
  overflow: hidden;
  padding: 92px 0 100px;
  background: #ffffff;
}
.results-heading {
  margin-bottom: 32px;
}
.results-heading h2 {
  margin: 15px 0 8px;
  color: var(--navy);
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 800;
  letter-spacing: -1.8px;
  line-height: 1.12;
}
.results-heading h2 span {
  color: var(--purple);
}
.results-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}
.results-rows {
  display: grid;
  gap: 20px;
}
.results-marquee {
  overflow: hidden;
  width: 100%;
  touch-action: pan-y;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 2%, #000 98%, transparent);
  mask-image: linear-gradient(to right, transparent, #000 2%, #000 98%, transparent);
}
.results-track {
  display: flex;
  width: max-content;
  gap: 18px;
  will-change: transform;
}
.results-track.move-left {
  animation: resultsMoveLeft 58s linear infinite;
}
.results-track.move-right {
  animation: resultsMoveRight 58s linear infinite;
}
.results-track:hover {
  animation-play-state: paused;
}
.results-track.is-dragging {
  animation: none !important;
  transform: translate3d(var(--drag-shift, 0px), 0, 0);
  cursor: grabbing;
}
.results-track-item {
  flex: 0 0 clamp(215px, 23vw, 270px);
}
.result-image-card {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  border: 1px solid rgba(81, 48, 124, 0.12);
  border-radius: 17px;
  background: #FFFFFF;
  box-shadow: 0 12px 32px rgba(3, 47, 98, 0.055);
}
.result-image-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms cubic-bezier(.2,.7,.2,1);
}
.result-image-card:hover img {
  transform: scale(1.045);
}
.result-social-label {
  position: absolute;
  right: 10px;
  bottom: 10px;
  left: 10px;
  display: flex;
  min-height: 42px;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 10px;
  color: var(--navy);
  background: rgba(255,255,255,.95);
  font-size: 11px;
  font-weight: 700;
  backdrop-filter: blur(12px);
}
.result-social-label > span:first-child {
  font-size: 20px;
  line-height: 1;
}
.result-social-label.instagram > span:first-child {
  color: var(--magenta);
