.rf-contact-closing {
  position: relative; overflow: hidden; padding: 75px 0; color: #fff;
  background: linear-gradient(112deg, #51307c 0%, #63307f 55%, #032f62 100%);
}
.rf-contact-closing-inner { position: relative; z-index: 1; }
.rf-contact-closing-inner > span { color: #f3c5e4; font-size: 9px; font-weight: 850; letter-spacing: .17em; }
.rf-contact-closing h2 { max-width: 760px; margin: 17px 0 12px; color: #fff; font-size: clamp(34px, 4.5vw, 56px); line-height: 1.1; letter-spacing: -.055em; }
.rf-contact-closing h2 span { color: #f3a6d5; }
.rf-contact-closing-inner > p { margin: 0; color: rgba(255,255,255,.78); font-size: 13px; line-height: 1.8; }
.rf-contact-closing-inner > a { margin-top: 26px; color: var(--purple); background: #fff; }
.rf-contact-closing-mark {
  position: absolute; right: 20px; top: 50%; color: rgba(255,255,255,.07);
  font-size: clamp(100px, 18vw, 220px); font-weight: 900; line-height: 1;
  letter-spacing: -.12em; transform: translateY(-50%); pointer-events: none;
}

@media (max-width: 900px) {
  .rf-contact-hero-inner { gap: 25px; }
  .rf-contact-hero-art { min-height: 360px; }
  .rf-contact-form-layout { grid-template-columns: 1fr; gap: 32px; }
  .rf-contact-form-intro { position: static; max-width: 650px; }
  .rf-contact-office { gap: 30px; }
}
@media (max-width: 640px) {
  .rf-contact-page .section-shell { width: calc(100% - 36px); }
  .rf-contact-hero { padding: 58px 0 36px; }
  .rf-contact-hero-inner { grid-template-columns: 1fr; gap: 10px; }
  .rf-contact-hero h1 { margin-top: 18px; font-size: clamp(41px, 11vw, 58px); }
  .rf-contact-hero-copy > p { font-size: 13px; }
  .rf-contact-hero-actions { gap: 9px; }
  .rf-contact-primary, .rf-contact-secondary { min-height: 46px; padding-inline: 14px; font-size: 11px; }
  .rf-contact-hero-art { min-height: 350px; margin-top: 8px; }
  .rf-contact-art-card { width: min(300px, 84%); padding: 25px; }
  .rf-contact-art-card h2 { font-size: 28px; }
  .rf-contact-floating-top { top: 20px; right: 0; }
  .rf-contact-floating-bottom { bottom: 15px; left: 0; }
  .rf-contact-scroll { margin-top: 15px; }
  .rf-contact-options { padding-top: 65px; padding-bottom: 65px; }
  .rf-contact-section-heading { margin-bottom: 27px; text-align: left; }
  .rf-contact-section-heading h2, .rf-contact-form-intro h2, .rf-contact-office-copy h2 { font-size: 34px; }
  .rf-contact-cards { grid-template-columns: 1fr; gap: 13px; }
  .rf-contact-card { min-height: 255px; padding: 24px; }
  .rf-contact-form-section { padding: 65px 0; }
  .rf-contact-form { padding: 23px 18px; border-radius: 15px; }
  .rf-contact-form-heading h3 { font-size: 22px; }
  .rf-contact-fields { grid-template-columns: 1fr; gap: 17px; }
  .rf-contact-fields .rf-contact-field-full { grid-column: auto; }
  .rf-contact-fields input, .rf-contact-fields select, .rf-contact-fields textarea { font-size: 16px; }
  .rf-contact-office { grid-template-columns: 1fr; gap: 25px; padding-top: 65px; padding-bottom: 65px; }
  .rf-contact-office-card { padding-inline: 17px; }
  .rf-contact-closing { padding: 60px 0; }
  .rf-contact-closing-mark { right: 0; top: auto; bottom: -25px; transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  .rf-contact-page *, .rf-contact-page *::before, .rf-contact-page *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}


/* ReachForever — redesigned Contact location and office-hours section */
.rf-find-us {
  position: relative;
  overflow: hidden;
  padding: clamp(64px, 8vw, 112px) 0;
  background: #FCFBFE;
}

.rf-find-us-inner {
  position: relative;
  z-index: 1;
}

.rf-find-us-heading {
  max-width: 720px;
  margin: 0 auto clamp(34px, 5vw, 54px);
  text-align: center;
}

.rf-find-us-eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
  color: #8B5CF6;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.rf-find-us-eyebrow > span {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #D946EF;
}

.rf-find-us-heading h2 {
  margin: 0;
  color: #211A2D;
  font-size: clamp(32px, 4.5vw, 54px);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.045em;
}

.rf-find-us-heading h2 > span {
  color: #9560D9;
}

.rf-find-us-heading > p {
  max-width: 550px;
  margin: 18px auto 0;
  color: #716B7B;
  font-size: 15px;
  line-height: 1.8;
}

.rf-find-us-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  max-width: 1000px;
  margin: 0 auto;
}

.rf-find-us-card {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 240px;
  flex-direction: column;
  align-items: flex-start;
  overflow: hidden;
  padding: clamp(24px, 3.5vw, 38px);
  border: 1px solid rgba(139, 92, 246, 0.12);
  border-radius: 20px;
  background: #FFFFFF;
  box-shadow: 0 12px 40px rgba(45, 27, 67, 0.045);
  transition: transform 220ms ease, box-shadow 220ms ease;
}

.rf-find-us-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 18px 48px rgba(45, 27, 67, 0.085);
}

.rf-find-us-location {
  background: linear-gradient(145deg, #FFFFFF 45%, #F5EEFF 100%);
}

.rf-find-us-hours {
  border-color: rgba(219, 39, 119, 0.12);
  background: linear-gradient(145deg, #FFFFFF 45%, #FFF0F6 100%);
}

.rf-find-us-icon {
  display: grid;
  width: 50px;
  height: 50px;
  flex: 0 0 50px;
  place-items: center;
  margin-bottom: 26px;
  border: 1px solid rgba(139, 92, 246, 0.13);
  border-radius: 15px;
  background: #F0E7FF;
  color: #8050D5;
}

.rf-find-us-hours .rf-find-us-icon {
  border-color: rgba(219, 39, 119, 0.12);
  background: #FFE3EF;
  color: #CB347A;
}

.rf-find-us-label {
  margin-bottom: 12px;
  color: #8959CF;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.rf-find-us-hours .rf-find-us-label {
  color: #C53678;
}

.rf-find-us-card h3 {
  position: relative;
  z-index: 1;
  max-width: 100%;
  margin: 0;
  color: #292132;
  font-size: clamp(19px, 2.2vw, 24px);
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.rf-find-us-card > p {
  position: relative;
  z-index: 1;
  margin: 12px 0 0;
  color: #797181;
  font-size: 12px;
  line-height: 1.7;
}

.rf-find-us-card > p.rf-find-us-time {
  color: #B83273;
  font-size: 15px;
  font-weight: 600;
}

.rf-find-us-card-number {
  position: absolute;
  right: 20px;
  bottom: 4px;
  color: rgba(139, 92, 246, 0.07);
  font-size: 92px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.08em;
  pointer-events: none;
}

.rf-find-us-hours .rf-find-us-card-number {
  color: rgba(219, 39, 119, 0.065);
}

@media (max-width: 640px) {
  .rf-find-us {
    padding: 60px 0 68px;
  }

  .rf-find-us-heading {
    margin-bottom: 30px;
    text-align: left;
  }

  .rf-find-us-heading h2 {
    font-size: clamp(31px, 8vw, 42px);
  }

  .rf-find-us-heading > p {
    margin: 14px 0 0;
    font-size: 14px;
  }

  .rf-find-us-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
  }

  .rf-find-us-card {
    min-height: 210px;
    padding: 25px;
    border-radius: 17px;
  }

  .rf-find-us-icon {
    margin-bottom: 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rf-find-us-card {
    transition: none;
  }

  .rf-find-us-card:hover {
    transform: none;
  }
}

